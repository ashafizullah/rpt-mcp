<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>RptMcp</RootNamespace>
    <AssemblyName>rpt-mcp</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Where the Crystal assemblies live depends on the runtime SP: older SPs use the legacy GAC with 13.0.2000.0
    (folder "13.0.2000.0__<token>"), newer SPs the .NET 4 GAC with 13.0.4000.0 (folder "v4.0_13.0.4000.0__<token>").
    Override with -p:CrGacMsil=... -p:CrVer=... if yours are elsewhere.
  -->
  <PropertyGroup>
    <CrLegacyGac>$(WINDIR)\assembly\GAC_MSIL</CrLegacyGac>
    <CrNet4Gac>$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL</CrNet4Gac>
    <CrEngine>CrystalDecisions.CrystalReports.Engine</CrEngine>
    <CrToken>692fbea5521e1304</CrToken>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CrGacMsil)' == '' and '$(CrVer)' == ''">
    <CrGacMsil Condition="Exists('$(CrLegacyGac)\$(CrEngine)\13.0.2000.0__$(CrToken)')">$(CrLegacyGac)</CrGacMsil>
    <CrVer Condition="'$(CrGacMsil)' != ''">13.0.2000.0__$(CrToken)</CrVer>
    <CrGacMsil Condition="'$(CrGacMsil)' == '' and Exists('$(CrLegacyGac)\$(CrEngine)\13.0.4000.0__$(CrToken)')">$(CrLegacyGac)</CrGacMsil>
    <CrVer Condition="'$(CrVer)' == '' and '$(CrGacMsil)' != ''">13.0.4000.0__$(CrToken)</CrVer>
    <CrGacMsil Condition="'$(CrGacMsil)' == '' and Exists('$(CrNet4Gac)\$(CrEngine)\v4.0_13.0.4000.0__$(CrToken)')">$(CrNet4Gac)</CrGacMsil>
    <CrVer Condition="'$(CrVer)' == '' and '$(CrGacMsil)' != ''">v4.0_13.0.4000.0__$(CrToken)</CrVer>
    <CrGacMsil Condition="'$(CrGacMsil)' == '' and Exists('$(CrNet4Gac)\$(CrEngine)\v4.0_13.0.2000.0__$(CrToken)')">$(CrNet4Gac)</CrGacMsil>
    <CrVer Condition="'$(CrVer)' == '' and '$(CrGacMsil)' != ''">v4.0_13.0.2000.0__$(CrToken)</CrVer>
  </PropertyGroup>
  <PropertyGroup>
    <CrGacMsil Condition="'$(CrGacMsil)' == ''">$(CrLegacyGac)</CrGacMsil>
    <CrVer Condition="'$(CrVer)' == ''">13.0.2000.0__$(CrToken)</CrVer>
  </PropertyGroup>

  <Target Name="ShowCrystalReferences" BeforeTargets="ResolveAssemblyReferences">
    <Message Importance="high" Text="Crystal assemblies: $(CrGacMsil)\...\$(CrVer)" />
    <Error Condition="!Exists('$(CrGacMsil)\$(CrEngine)\$(CrVer)\$(CrEngine).dll')"
           Text="SAP Crystal Reports runtime assemblies not found ($(CrGacMsil)\$(CrEngine)\$(CrVer)). Install the runtime, or pass -p:CrGacMsil=... -p:CrVer=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- Crystal Reports runtime 13 (SP) must be installed; assemblies are resolved from the GAC at runtime.
       Some are platform-neutral (GAC_MSIL), some 64-bit only (GAC_64), depending on the SP. -->
  <PropertyGroup>
    <CrGac64>$([System.String]::Copy('$(CrGacMsil)').Replace('GAC_MSIL', 'GAC_64'))</CrGac64>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CrystalDecisions.CrystalReports.Engine"><HintPath Condition="Exists('$(CrGacMsil)\CrystalDecisions.CrystalReports.Engine\$(CrVer)\CrystalDecisions.CrystalReports.Engine.dll')">$(CrGacMsil)\CrystalDecisions.CrystalReports.Engine\$(CrVer)\CrystalDecisions.CrystalReports.Engine.dll</HintPath><HintPath Condition="!Exists('$(CrGacMsil)\CrystalDecisions.CrystalReports.Engine\$(CrVer)\CrystalDecisions.CrystalReports.Engine.dll')">$(CrGac64)\CrystalDecisions.CrystalReports.Engine\$(CrVer)\CrystalDecisions.CrystalReports.Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CrystalDecisions.Shared"><HintPath Condition="Exists('$(CrGacMsil)\CrystalDecisions.Shared\$(CrVer)\CrystalDecisions.Shared.dll')">$(CrGacMsil)\CrystalDecisions.Shared\$(CrVer)\CrystalDecisions.Shared.dll</HintPath><HintPath Condition="!Exists('$(CrGacMsil)\CrystalDecisions.Shared\$(CrVer)\CrystalDecisions.Shared.dll')">$(CrGac64)\CrystalDecisions.Shared\$(CrVer)\CrystalDecisions.Shared.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CrystalDecisions.ReportSource"><HintPath Condition="Exists('$(CrGacMsil)\CrystalDecisions.ReportSource\$(CrVer)\CrystalDecisions.ReportSource.dll')">$(CrGacMsil)\CrystalDecisions.ReportSource\$(CrVer)\CrystalDecisions.ReportSource.dll</HintPath><HintPath Condition="!Exists('$(CrGacMsil)\CrystalDecisions.ReportSource\$(CrVer)\CrystalDecisions.ReportSource.dll')">$(CrGac64)\CrystalDecisions.ReportSource\$(CrVer)\CrystalDecisions.ReportSource.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.ClientDoc"><HintPath Condition="Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.ClientDoc\$(CrVer)\CrystalDecisions.ReportAppServer.ClientDoc.dll')">$(CrGacMsil)\CrystalDecisions.ReportAppServer.ClientDoc\$(CrVer)\CrystalDecisions.ReportAppServer.ClientDoc.dll</HintPath><HintPath Condition="!Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.ClientDoc\$(CrVer)\CrystalDecisions.ReportAppServer.ClientDoc.dll')">$(CrGac64)\CrystalDecisions.ReportAppServer.ClientDoc\$(CrVer)\CrystalDecisions.ReportAppServer.ClientDoc.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.Controllers"><HintPath Condition="Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.Controllers\$(CrVer)\CrystalDecisions.ReportAppServer.Controllers.dll')">$(CrGacMsil)\CrystalDecisions.ReportAppServer.Controllers\$(CrVer)\CrystalDecisions.ReportAppServer.Controllers.dll</HintPath><HintPath Condition="!Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.Controllers\$(CrVer)\CrystalDecisions.ReportAppServer.Controllers.dll')">$(CrGac64)\CrystalDecisions.ReportAppServer.Controllers\$(CrVer)\CrystalDecisions.ReportAppServer.Controllers.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.DataDefModel"><HintPath Condition="Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.DataDefModel\$(CrVer)\CrystalDecisions.ReportAppServer.DataDefModel.dll')">$(CrGacMsil)\CrystalDecisions.ReportAppServer.DataDefModel\$(CrVer)\CrystalDecisions.ReportAppServer.DataDefModel.dll</HintPath><HintPath Condition="!Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.DataDefModel\$(CrVer)\CrystalDecisions.ReportAppServer.DataDefModel.dll')">$(CrGac64)\CrystalDecisions.ReportAppServer.DataDefModel\$(CrVer)\CrystalDecisions.ReportAppServer.DataDefModel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.ReportDefModel"><HintPath Condition="Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.ReportDefModel\$(CrVer)\CrystalDecisions.ReportAppServer.ReportDefModel.dll')">$(CrGacMsil)\CrystalDecisions.ReportAppServer.ReportDefModel\$(CrVer)\CrystalDecisions.ReportAppServer.ReportDefModel.dll</HintPath><HintPath Condition="!Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.ReportDefModel\$(CrVer)\CrystalDecisions.ReportAppServer.ReportDefModel.dll')">$(CrGac64)\CrystalDecisions.ReportAppServer.ReportDefModel\$(CrVer)\CrystalDecisions.ReportAppServer.ReportDefModel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.CommonObjectModel"><HintPath Condition="Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.CommonObjectModel\$(CrVer)\CrystalDecisions.ReportAppServer.CommonObjectModel.dll')">$(CrGacMsil)\CrystalDecisions.ReportAppServer.CommonObjectModel\$(CrVer)\CrystalDecisions.ReportAppServer.CommonObjectModel.dll</HintPath><HintPath Condition="!Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.CommonObjectModel\$(CrVer)\CrystalDecisions.ReportAppServer.CommonObjectModel.dll')">$(CrGac64)\CrystalDecisions.ReportAppServer.CommonObjectModel\$(CrVer)\CrystalDecisions.ReportAppServer.CommonObjectModel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.ObjectFactory"><HintPath Condition="Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.ObjectFactory\$(CrVer)\CrystalDecisions.ReportAppServer.ObjectFactory.dll')">$(CrGacMsil)\CrystalDecisions.ReportAppServer.ObjectFactory\$(CrVer)\CrystalDecisions.ReportAppServer.ObjectFactory.dll</HintPath><HintPath Condition="!Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.ObjectFactory\$(CrVer)\CrystalDecisions.ReportAppServer.ObjectFactory.dll')">$(CrGac64)\CrystalDecisions.ReportAppServer.ObjectFactory\$(CrVer)\CrystalDecisions.ReportAppServer.ObjectFactory.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.CommLayer"><HintPath Condition="Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.CommLayer\$(CrVer)\CrystalDecisions.ReportAppServer.CommLayer.dll')">$(CrGacMsil)\CrystalDecisions.ReportAppServer.CommLayer\$(CrVer)\CrystalDecisions.ReportAppServer.CommLayer.dll</HintPath><HintPath Condition="!Exists('$(CrGacMsil)\CrystalDecisions.ReportAppServer.CommLayer\$(CrVer)\CrystalDecisions.ReportAppServer.CommLayer.dll')">$(CrGac64)\CrystalDecisions.ReportAppServer.CommLayer\$(CrVer)\CrystalDecisions.ReportAppServer.CommLayer.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
